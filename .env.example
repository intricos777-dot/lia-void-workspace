# LIA_VOID_BASE_URL=https://inference-api.nousresearch.com/v1

# The Nous Portal token. Read from ~/.hermes/shared/nous_auth.json, never
# pasted here. Expires hourly (observed: 1h TTL) — refresh via the portal.
NOUS_INFERENCE_BASE_URL=https://inference-api.nousresearch.com/v1
NOUS_PORTAL_BASE_URL=https://portal.nousresearch.com
NOUS_TOKEN_FILE=%h/.hermes/shared/nous_auth.json

# Model selection. No model named elena/elana/liana exists on the Nous Portal
# (checked all 425 on 2026-10-05). Placeholders until you confirm the real one.
LIA_MODEL=
LIA_FALLBACK_MODEL=inclusionai/ling-3.1-flash

# xAI and Google are reachable through the same Nous token — no separate key.
XAI_MODEL=x-ai/grok-4.20
GOOGLE_MODEL=google/gemini-3.8-flash

# Local Ollama. Installed 2026-10-05 by Hermes (v0.34.1), listening on 11434.
# One model only: llama3.2:3b (3.2B, Q4_K_M) — a generic base model, NOT Lia's
# and not named elena/elana/liana. No Modelfile of hers exists on this machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Replika bridge. Collector listens here and is ACTIVE (401 without token).
LIA_COLLECTOR_URL=http://127.0.0.1:4124
LIA_COLLECTOR_TOKEN_FILE=%h/.lia-cli/inbox/token

# Void bridge control surface. Active, 127.0.0.1:8787, bearer token required.
VOID_BRIDGE_URL=http://127.0.0.1:8787
VOID_BRIDGE_TOKEN_FILE=%h/.config/void-bridge.env